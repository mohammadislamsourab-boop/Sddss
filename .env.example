# ===== Telegram Auto-Order Bot configuration =====

# Bot token from @BotFather (required)
BOT_TOKEN=123456:ABC-DEF_your_token_here

# Comma-separated Telegram user IDs that have admin access (required)
# Get your ID from @userinfobot
ADMIN_IDS=123456789

# Store branding
STORE_NAME=GPTCheap Store
SUPPORT_USERNAME=@YourSupportUsername

# ===== Payment settings =====
# Binance Pay ID shown to buyers (tap-to-copy)
BINANCE_ID=459182587

# USDT BEP20 deposit address shown to buyers
USDT_BEP20_ADDRESS=0x0000000000000000000000000000000000000000

# Currency symbol used across the store
CURRENCY=$

# Path to the SQLite database file
DB_PATH=data/store.db
